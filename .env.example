# Anthropic API key for the agent (Tool Runner). Can also be resolved via
# `ant auth login` — see the Anthropic CLI docs — in which case leave this unset.
ANTHROPIC_API_KEY=sk-ant-...

# Local TWS / IB Gateway connection. Defaults match TWS paper trading.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=17

# Runtime state directory (mandate, halt sentinel, audit ledger, data cache).
# Defaults to ~/.ibkr-eu-trader if unset.
# RUNTIME_ROOT=~/.ibkr-eu-trader

# ---------------------------------------------------------------------------
# IMPORTANT — read before enabling live trading
# ---------------------------------------------------------------------------
# TWS has its own "Read Only API" setting (Edit -> Global Configuration ->
# API -> Settings), which is ON BY DEFAULT. While enabled, TWS rejects every
# order-placing API call regardless of what this app sends or what mandate
# is committed. No code in this repo can toggle it — you must disable it
# yourself in TWS before any live (or paper) order will actually place.
